# VerifyWise lab env — copy to docker/verifywise.env (gitignored)
# Used by scripts/verifywise-up.ps1

# URLs (loopback lab)
FRONTEND_URL=http://127.0.0.1:18080
BACKEND_URL=http://127.0.0.1:13000
BACKEND_PORT=3000
FRONTEND_PORT=18080

# Postgres
DB_USER=verifywise
DB_PASSWORD=change-me-vw-db
DB_NAME=verifywise
DB_PORT=5432

# Auth — change before first boot
JWT_SECRET=change-me-generate-with-openssl-rand-base64-32
SUPERADMIN_EMAIL=admin@cadre.local
SUPERADMIN_PASSWORD=change-me-superadmin-password

# Crypto / gateway
ENCRYPTION_KEY=change-me-32-char-encryption-key!!
AI_GATEWAY_INTERNAL_KEY=change-me-ai-gateway-internal-key

# Optional
MOCK_DATA_ON=false
